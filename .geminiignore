# .geminiignore - AI context and indexing exclusions to save tokens

# Python & Package caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Testing & Cache directories (Heavy token consumers)
tests/
.pytest_cache/
.coverage
htmlcov/
.tox/

# Git internals
.git/
.github/

# IDE & Editor artifacts
.vscode/
.idea/
*.swp
*.swo
*~

# OS artifacts
.DS_Store
Thumbs.db
desktop.ini

# Secrets and environment configs
.env*
*.env
*.pem
*.key
*.cert
*.secret
credentials*
*.token
service_account*.json
.streamlit/secrets*
.streamlit/*.toml

# Large Data, Media, Models and Binary Exports
*.pkl
*.joblib
*.h5
*.onnx
*.csv
*.xlsx
*.xls
*.tsv
*.parquet
*.feather
*.zip
*.tar.gz
*.pdf
*.png
*.jpg
*.jpeg
*.svg
data/
datasets/
models/
exports/
scratch/
tmp/
temp/
logs/
*.log
